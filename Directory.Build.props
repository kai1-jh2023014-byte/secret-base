<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Secret Base stack (2026-08): .NET 10 LTS + Windows App SDK 2.3.1 -->
    <SecretBaseDotnetTfm>net10.0</SecretBaseDotnetTfm>
    <SecretBaseWindowsTfm>net10.0-windows10.0.26100.0</SecretBaseWindowsTfm>
    <WindowsAppSdkVersion>2.3.1</WindowsAppSdkVersion>
  </PropertyGroup>
</Project>
