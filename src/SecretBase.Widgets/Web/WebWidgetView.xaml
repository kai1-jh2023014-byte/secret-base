<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Web.WebWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Web content is Untrusted. Host chrome (move) stays on WidgetFrame DragBar —
      never drag from the WebView surface.
    -->
    <Border
        x:Name="RootBorder"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Minimal toolbar: URL + Go + Reload (not a full browser). -->
            <Grid
                x:Name="Toolbar"
                Grid.Row="0"
                Padding="8,6"
                ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="UrlBox"
                    Grid.Column="0"
                    PlaceholderText="https://"
                    FontSize="12"
                    MinHeight="28"
                    VerticalAlignment="Center"
                    KeyDown="UrlBox_KeyDown" />

                <Button
                    x:Name="GoButton"
                    Grid.Column="1"
                    Content="Go"
                    MinWidth="44"
                    Padding="10,4"
                    Click="GoButton_Click"
                    ToolTipService.ToolTip="Navigate" />

                <Button
                    x:Name="ReloadButton"
                    Grid.Column="2"
                    Content="↻"
                    MinWidth="36"
                    Padding="8,4"
                    Click="ReloadButton_Click"
                    ToolTipService.ToolTip="Reload" />
            </Grid>

            <Grid Grid.Row="1">
                <WebView2
                    x:Name="Browser"
                    DefaultBackgroundColor="Transparent" />

                <Border
                    x:Name="StatusOverlay"
                    Visibility="Collapsed"
                    Background="#CC1A1F2A"
                    Padding="16">
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="36"
                            Height="36"
                            IsActive="False"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusText"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            FontSize="13"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
