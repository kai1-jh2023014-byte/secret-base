<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Dashboard.DashboardWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="OuterShell"
        Background="#20151A24"
        CornerRadius="20"
        Padding="2"
        BorderThickness="1"
        BorderBrush="#28FFFFFF">
        <Border
            x:Name="RootBorder"
            Padding="18,16"
            Background="#D9181E28"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#3DFFFFFF"
            MinWidth="260"
            MinHeight="280">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="TimeText"
                        Text="--"
                        FontSize="28"
                        FontWeight="Light"
                        CharacterSpacing="60" />
                    <TextBlock
                        x:Name="GreetingText"
                        Text="GOOD EVENING"
                        FontSize="12"
                        FontWeight="SemiBold"
                        CharacterSpacing="80"
                        Opacity="0.8" />
                    <TextBlock
                        x:Name="ReadyText"
                        Text="Your Base is ready."
                        FontSize="13"
                        Opacity="0.9" />
                </StackPanel>

                <Border
                    x:Name="ContinuationCard"
                    Grid.Row="1"
                    Padding="12"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="#28FFFFFF"
                    Background="#18151A24">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="ProjectText"
                            FontSize="16"
                            FontWeight="SemiLight"
                            TextWrapping="WrapWholeWords"
                            Text="No project yet" />
                        <TextBlock
                            x:Name="SessionText"
                            FontSize="12"
                            Opacity="0.8"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="NextText"
                            FontSize="12"
                            Opacity="0.8"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="SuggestionText"
                            FontSize="12"
                            Opacity="0.85"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ContinueButton"
                                Content="Continue"
                                MinWidth="88"
                                Click="ContinueButton_Click" />
                            <Button
                                x:Name="NotNowButton"
                                Content="Not now"
                                MinWidth="88"
                                Click="NotNowButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CalendarLabel" FontSize="11" Opacity="0.7" Text="Calendar" />
                        <TextBlock x:Name="CalendarValue" FontSize="12" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="TasksLabel" FontSize="11" Opacity="0.7" Text="Tasks" Margin="0,6,0,0" />
                        <TextBlock x:Name="TasksValue" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="MusicLabel" FontSize="11" Opacity="0.7" Text="Music" />
                        <TextBlock x:Name="MusicValue" FontSize="12" TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="AiLabel" FontSize="11" Opacity="0.7" Text="Base AI" Margin="0,6,0,0" />
                        <TextBlock x:Name="AiValue" FontSize="12" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
