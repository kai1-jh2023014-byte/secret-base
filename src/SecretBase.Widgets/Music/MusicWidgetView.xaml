<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Music.MusicWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Native Music UI — Secret Base chrome first.
      External pages are NOT the primary surface (no Host Bridge).
      Move/resize stay on WidgetFrame DragBar.
    -->
    <Border
        x:Name="RootBorder"
        Padding="12,10"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF"
        MinWidth="280"
        MinHeight="360">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="HeaderText"
                Grid.Row="0"
                Text="Music"
                FontSize="18"
                FontWeight="SemiBold" />

            <StackPanel
                x:Name="ConnectPanel"
                Grid.Row="1"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ConnectPromptText"
                    Text="Connect your music service"
                    FontSize="13"
                    TextWrapping="WrapWholeWords" />
                <Button
                    x:Name="ConnectSpotifyButton"
                    Content="Spotify"
                    HorizontalAlignment="Stretch"
                    Click="ConnectSpotifyButton_Click" />
                <Button
                    x:Name="ConnectYouTubeButton"
                    Content="YouTube Music"
                    HorizontalAlignment="Stretch"
                    Click="ConnectYouTubeButton_Click" />
                <HyperlinkButton
                    x:Name="LaterConnectButton"
                    Content="Later"
                    Click="LaterConnectButton_Click" />
            </StackPanel>

            <!-- Search -->
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Search tracks…"
                    FontSize="12"
                    MinHeight="28"
                    KeyDown="SearchBox_KeyDown" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Search"
                    MinWidth="64"
                    Padding="10,4"
                    Click="SearchButton_Click" />
            </Grid>

            <!-- Results -->
            <ScrollViewer
                Grid.Row="3"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ResultsList" Spacing="4" />
            </ScrollViewer>

            <!-- Current track -->
            <Grid x:Name="CurrentTrackPanel" Grid.Row="4" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="ArtPlaceholder"
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="8"
                    Background="#33FFFFFF">
                    <TextBlock
                        x:Name="ArtGlyph"
                        Text="♪"
                        FontSize="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.85" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="TrackTitleText"
                        Text="No track selected"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="TrackArtistText"
                        Text=""
                        FontSize="12"
                        Opacity="0.8"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <ProgressBar
                x:Name="PlaybackProgress"
                Grid.Row="5"
                Maximum="100"
                Value="0"
                Height="4"
                Visibility="Collapsed" />

            <!-- Transport -->
            <Grid Grid.Row="6" ColumnSpacing="8" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousButton"
                    Grid.Column="0"
                    Content="◀"
                    MinWidth="44"
                    Click="PreviousButton_Click"
                    ToolTipService.ToolTip="Previous" />
                <Button
                    x:Name="PlayPauseButton"
                    Grid.Column="1"
                    Content="▶"
                    MinWidth="52"
                    Click="PlayPauseButton_Click"
                    ToolTipService.ToolTip="Play / Pause" />
                <Button
                    x:Name="NextButton"
                    Grid.Column="2"
                    Content="▶▶"
                    MinWidth="44"
                    Click="NextButton_Click"
                    ToolTipService.ToolTip="Next" />
            </Grid>

            <StackPanel Grid.Row="7" Spacing="4">
                <TextBlock
                    x:Name="SourceLabel"
                    FontSize="11"
                    Opacity="0.8"
                    Text="Source: Demo catalog"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="StatusLabel"
                    FontSize="11"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords"
                    Text="" />
                <Button
                    x:Name="OpenWebSourceButton"
                    Content="Open web source…"
                    HorizontalAlignment="Stretch"
                    Click="OpenWebSourceButton_Click"
                    ToolTipService.ToolTip="Optional: open registered Spotify/YouTube URL in the system browser (not in-widget WebView)" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
