<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Music.MusicWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Music Hub MVP. Web browsing is Untrusted WebView2 (same harden as Web Widget).
      Move/resize stay on WidgetFrame DragBar — never drag from the WebView.
    -->
    <Border
        x:Name="RootBorder"
        Padding="0"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderBar"
                Grid.Row="0"
                Padding="14,10"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    Content="←"
                    MinWidth="36"
                    Padding="8,4"
                    Visibility="Collapsed"
                    Click="BackButton_Click"
                    ToolTipService.ToolTip="Back to sources" />
                <TextBlock
                    x:Name="HeaderText"
                    Grid.Column="1"
                    Text="Music"
                    FontSize="18"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="HeaderSubText"
                    Grid.Column="2"
                    FontSize="11"
                    Opacity="0.75"
                    VerticalAlignment="Center"
                    Text="" />
            </Grid>

            <!-- Hub: source list -->
            <Grid x:Name="HubPanel" Grid.Row="1" Padding="14,0,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SourceList" Spacing="8" />
                </ScrollViewer>

                <TextBlock
                    x:Name="HubHint"
                    Grid.Row="1"
                    Margin="0,8,0,8"
                    FontSize="12"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords"
                    Text="Pick a source to open it here. Web content stays Untrusted — no Host Bridge." />

                <Button
                    x:Name="AddSourceButton"
                    Grid.Row="2"
                    Content="+ Add source"
                    HorizontalAlignment="Stretch"
                    Click="AddSourceButton_Click"
                    ToolTipService.ToolTip="Add Spotify, YouTube, Web, or Local placeholder" />
            </Grid>

            <!-- Browse: hardened WebView2 -->
            <Grid x:Name="BrowsePanel" Grid.Row="1" Visibility="Collapsed">
                <WebView2
                    x:Name="Browser"
                    DefaultBackgroundColor="Transparent" />
                <Border
                    x:Name="StatusOverlay"
                    Visibility="Collapsed"
                    Background="#CC1A1F2A"
                    Padding="16">
                    <StackPanel VerticalAlignment="Center" Spacing="8">
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="36"
                            Height="36"
                            IsActive="False"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusText"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords"
                            FontSize="13"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
