<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Assistant.AssistantWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="RootBorder"
        Padding="12,10"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF"
        MinWidth="280"
        MinHeight="360">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="HeaderText"
                    Text="Secret Base AI"
                    FontSize="17"
                    FontWeight="SemiBold"
                    TextWrapping="WrapWholeWords" />
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="1"
                    Content="Settings"
                    MinWidth="72"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="AI provider and API key" />
            </Grid>

            <ScrollViewer
                x:Name="TranscriptScroll"
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Transcript" Spacing="8" />
            </ScrollViewer>

            <StackPanel
                x:Name="ConfirmPanel"
                Grid.Row="2"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ConfirmText"
                    FontSize="12"
                    TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ConfirmCancelButton"
                        Content="Cancel"
                        MinWidth="80"
                        Click="ConfirmCancel_Click" />
                    <Button
                        x:Name="ConfirmRunButton"
                        Content="Run"
                        MinWidth="88"
                        Click="ConfirmRun_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="StatusLabel"
                Grid.Row="3"
                FontSize="11"
                Opacity="0.75"
                TextWrapping="WrapWholeWords" />

            <Grid Grid.Row="4" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="InputBox"
                    PlaceholderText="Message…"
                    KeyDown="InputBox_KeyDown" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    MinWidth="64"
                    Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
