<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Assistant.AssistantWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="RootBorder"
        Padding="12,10"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF"
        MinWidth="280"
        MinHeight="360">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        x:Name="HeaderText"
                        Text="Secret Base AI"
                        FontSize="17"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="SubtitleText"
                        Text="Context · Plan · Confirm · Action"
                        FontSize="11"
                        Opacity="0.75"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="1"
                    Content="Settings"
                    MinWidth="72"
                    VerticalAlignment="Top"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="AI provider and API key" />
            </Grid>

            <TextBlock
                x:Name="ProviderStatusText"
                Grid.Row="1"
                FontSize="11"
                Opacity="0.8"
                TextWrapping="WrapWholeWords" />

            <StackPanel
                x:Name="OnboardingPanel"
                Grid.Row="2"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="OnboardingText"
                    Text="Secret Base AI understands your schedule, projects, apps, and music, then suggests safe next steps. It does not control your PC freely."
                    FontSize="12"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    x:Name="CapabilitiesText"
                    Text="Capabilities:&#x0a;✓ Calendar&#x0a;✓ Projects&#x0a;✓ Apps&#x0a;✓ Music&#x0a;✓ Cursor&#x0a;✓ Suggestions"
                    FontSize="11"
                    Opacity="0.9"
                    TextWrapping="WrapWholeWords" />
                <Button
                    x:Name="OpenSettingsFromOnboardingButton"
                    Content="Open AI Settings"
                    MinWidth="120"
                    HorizontalAlignment="Left"
                    Click="SettingsButton_Click" />
            </StackPanel>

            <ScrollViewer
                x:Name="TranscriptScroll"
                Grid.Row="3"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Transcript" Spacing="8" />
            </ScrollViewer>

            <StackPanel
                x:Name="ConfirmPanel"
                Grid.Row="4"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ConfirmText"
                    FontSize="12"
                    TextWrapping="WrapWholeWords" />
                <StackPanel
                    x:Name="ConfirmActionList"
                    Spacing="2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="ConfirmCancelButton"
                        Content="Cancel"
                        MinWidth="80"
                        Click="ConfirmCancel_Click" />
                    <Button
                        x:Name="ConfirmRunButton"
                        Content="Run"
                        MinWidth="88"
                        Click="ConfirmRun_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                x:Name="StatusLabel"
                Grid.Row="5"
                FontSize="11"
                Opacity="0.75"
                TextWrapping="WrapWholeWords" />

            <StackPanel
                x:Name="ErrorActionPanel"
                Grid.Row="6"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <Button
                    x:Name="RetryButton"
                    Content="Retry"
                    MinWidth="80"
                    Click="RetryButton_Click" />
                <Button
                    x:Name="OpenSettingsFromErrorButton"
                    Content="AI Settings"
                    MinWidth="96"
                    Click="SettingsButton_Click" />
            </StackPanel>

            <Grid Grid.Row="7" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="InputBox"
                    PlaceholderText="Ask about today, projects, apps…"
                    KeyDown="InputBox_KeyDown" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    MinWidth="64"
                    Click="SendButton_Click" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
