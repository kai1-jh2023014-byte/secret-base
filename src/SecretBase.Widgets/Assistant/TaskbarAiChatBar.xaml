<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Assistant.TaskbarAiChatBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Overlay AI command bar — sits in the work area just above the Windows taskbar.
      Does not replace Explorer SearchHost / Windows Search.
    -->
    <Grid
        x:Name="Root"
        MinWidth="420"
        MaxWidth="640"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ResultsShell"
            Grid.Row="0"
            Visibility="Collapsed"
            Padding="14,12"
            CornerRadius="16"
            BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    x:Name="TranscriptScroll"
                    Grid.Row="0"
                    MaxHeight="220"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Transcript" Spacing="6" />
                </ScrollViewer>
                <StackPanel
                    x:Name="ConfirmPanel"
                    Grid.Row="1"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ConfirmText"
                        FontSize="12"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ConfirmCancelButton"
                            Content="Cancel"
                            MinWidth="80"
                            Click="ConfirmCancel_Click" />
                        <Button
                            x:Name="ConfirmRunButton"
                            Content="Run"
                            MinWidth="88"
                            Click="ConfirmRun_Click" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Name="StatusLabel"
                    Grid.Row="2"
                    FontSize="11"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <Border
            x:Name="Pill"
            Grid.Row="1"
            Padding="12,8"
            CornerRadius="22"
            BorderThickness="1"
            MinHeight="44">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Spacing="0">
                    <TextBlock
                        x:Name="BrandText"
                        Text="Secret Base"
                        FontSize="10"
                        CharacterSpacing="40"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="ProviderText"
                        Text="AI"
                        FontSize="10"
                        Opacity="0.8" />
                </StackPanel>
                <TextBox
                    x:Name="InputBox"
                    Grid.Column="1"
                    PlaceholderText="Ask Secret Base…"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    KeyDown="InputBox_KeyDown" />
                <Button
                    x:Name="SendButton"
                    Grid.Column="2"
                    Content="➤"
                    MinWidth="40"
                    MinHeight="32"
                    Padding="8,4"
                    Click="SendButton_Click"
                    ToolTipService.ToolTip="Send (Enter)" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
