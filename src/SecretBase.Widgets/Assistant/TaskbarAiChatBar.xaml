<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Assistant.TaskbarAiChatBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Overlay shelf along the bottom of the work area, just above the Windows taskbar.
      Clock, focus, and the next item sit beside the AI field. Does not replace the taskbar or Windows Search.
    -->
    <Grid
        x:Name="Root"
        HorizontalAlignment="Stretch"
        MinWidth="520"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="ResultsShell"
            Grid.Row="0"
            Visibility="Collapsed"
            Padding="14,12"
            CornerRadius="16"
            BorderThickness="1">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    x:Name="TranscriptScroll"
                    Grid.Row="0"
                    MaxHeight="220"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Transcript" Spacing="6" />
                </ScrollViewer>
                <StackPanel
                    x:Name="ConfirmPanel"
                    Grid.Row="1"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ConfirmText"
                        FontSize="12"
                        TextWrapping="WrapWholeWords" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ConfirmCancelButton"
                            Content="Cancel"
                            MinWidth="80"
                            Click="ConfirmCancel_Click" />
                        <Button
                            x:Name="ConfirmRunButton"
                            Content="Run"
                            MinWidth="88"
                            Click="ConfirmRun_Click" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    x:Name="StatusLabel"
                    Grid.Row="2"
                    FontSize="11"
                    Opacity="0.8"
                    TextWrapping="WrapWholeWords" />
            </Grid>
        </Border>

        <Border
            x:Name="Pill"
            Grid.Row="1"
            Padding="16,8"
            CornerRadius="18"
            BorderThickness="1"
            MinHeight="56">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="ClockColumn"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    MinWidth="88"
                    Spacing="0">
                    <TextBlock
                        x:Name="ClockText"
                        Text="--:--"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DateText"
                        Text=""
                        FontSize="11"
                        Opacity="0.75" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            x:Name="BrandText"
                            Text="Base"
                            FontSize="10"
                            CharacterSpacing="40"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="ProviderText"
                            Text="AI"
                            FontSize="10"
                            Opacity="0.8" />
                    </StackPanel>
                    <TextBox
                        x:Name="InputBox"
                        Grid.Column="1"
                        PlaceholderText="Ask Secret Base…"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        KeyDown="InputBox_KeyDown" />
                    <Button
                        x:Name="SendButton"
                        Grid.Column="2"
                        Content="➤"
                        MinWidth="40"
                        MinHeight="32"
                        Padding="8,4"
                        Click="SendButton_Click"
                        ToolTipService.ToolTip="Send (Enter)" />
                </Grid>
                <StackPanel
                    x:Name="StatusColumn"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    MinWidth="140"
                    MaxWidth="240"
                    Spacing="2">
                    <TextBlock
                        x:Name="FocusText"
                        Text="Focus idle"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="NextText"
                        Text="Nothing queued"
                        FontSize="11"
                        Opacity="0.8"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
