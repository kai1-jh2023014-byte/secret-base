<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Clock.ClockWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Opacity="0">

    <!-- Atelier Clock — Base / Large digital / Minimal / Analog / Focus. -->
    <Border
        x:Name="OuterShell"
        Background="#20151A24"
        CornerRadius="20"
        Padding="2"
        BorderThickness="1"
        BorderBrush="#28FFFFFF">
        <Border
            x:Name="RootBorder"
            Padding="22,18"
            Background="#66181E28"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#3DFFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border
                        x:Name="AccentHairline"
                        Width="28"
                        Height="2"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="1"
                        Background="#FF7A9E86"
                        Opacity="0.85" />
                    <Button
                        x:Name="SettingsButton"
                        Content="..."
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="32"
                        MinHeight="26"
                        Padding="6,2"
                        Opacity="0.55"
                        Click="SettingsButton_Click"
                        ToolTipService.ToolTip="Clock style and format" />
                </Grid>

                <Grid x:Name="DigitalPanel" Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel x:Name="DigitalStack" VerticalAlignment="Center" Spacing="6">
                        <TextBlock
                            x:Name="TimeText"
                            Text="00:00"
                            FontSize="44"
                            FontWeight="SemiBold"
                            CharacterSpacing="80"
                            Foreground="#FFF3EFE6"
                            HorizontalAlignment="Left"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Name="DateText"
                            Text="Wednesday, September 01"
                            FontSize="13"
                            FontWeight="Normal"
                            CharacterSpacing="30"
                            LineHeight="20"
                            Foreground="#FF8B93A0"
                            HorizontalAlignment="Left"
                            TextAlignment="Left"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="StatusText"
                            Text=""
                            FontSize="11"
                            FontWeight="SemiBold"
                            CharacterSpacing="40"
                            Foreground="#FF7A9E86"
                            HorizontalAlignment="Left"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="NextText"
                            Text=""
                            FontSize="12"
                            Foreground="#FF8B93A0"
                            HorizontalAlignment="Left"
                            TextWrapping="WrapWholeWords"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <Grid
                    x:Name="AnalogPanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <Canvas
                            x:Name="AnalogCanvas"
                            Width="132"
                            Height="132"
                            HorizontalAlignment="Center">
                            <Ellipse
                                x:Name="AnalogRingOuter"
                                Width="132"
                                Height="132"
                                Fill="#14000000"
                                Stroke="#28FFFFFF"
                                StrokeThickness="1" />
                            <Ellipse
                                x:Name="AnalogFace"
                                Width="118"
                                Height="118"
                                Canvas.Left="7"
                                Canvas.Top="7"
                                Fill="#22000000"
                                Stroke="#55FFFFFF"
                                StrokeThickness="1" />
                            <Canvas x:Name="AnalogTicks" Width="132" Height="132" />
                            <TextBlock
                                x:Name="AnalogMark12"
                                Text="12"
                                FontSize="10"
                                Opacity="0.75"
                                Canvas.Left="60"
                                Canvas.Top="14"
                                Foreground="#CCFFFFFF" />
                            <TextBlock
                                x:Name="AnalogMark3"
                                Text="3"
                                FontSize="10"
                                Opacity="0.75"
                                Canvas.Left="104"
                                Canvas.Top="58"
                                Foreground="#CCFFFFFF" />
                            <TextBlock
                                x:Name="AnalogMark6"
                                Text="6"
                                FontSize="10"
                                Opacity="0.75"
                                Canvas.Left="63"
                                Canvas.Top="102"
                                Foreground="#CCFFFFFF" />
                            <TextBlock
                                x:Name="AnalogMark9"
                                Text="9"
                                FontSize="10"
                                Opacity="0.75"
                                Canvas.Left="18"
                                Canvas.Top="58"
                                Foreground="#CCFFFFFF" />
                            <Line
                                x:Name="HourHand"
                                X1="66"
                                Y1="66"
                                X2="66"
                                Y2="40"
                                StrokeThickness="3"
                                Stroke="#FFF3EFE6" />
                            <Line
                                x:Name="MinuteHand"
                                X1="66"
                                Y1="66"
                                X2="66"
                                Y2="28"
                                StrokeThickness="2"
                                Stroke="#FFF3EFE6" />
                            <Line
                                x:Name="SecondHand"
                                X1="66"
                                Y1="66"
                                X2="66"
                                Y2="24"
                                StrokeThickness="1"
                                Stroke="#FF7A9E86"
                                Opacity="0.9" />
                            <Ellipse
                                x:Name="AnalogCenter"
                                Width="6"
                                Height="6"
                                Fill="#FF7A9E86"
                                Canvas.Left="63"
                                Canvas.Top="63" />
                        </Canvas>
                        <TextBlock
                            x:Name="AnalogCaption"
                            Text="Clock"
                            FontSize="11"
                            Opacity="0.7"
                            HorizontalAlignment="Center"
                            CharacterSpacing="40" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
