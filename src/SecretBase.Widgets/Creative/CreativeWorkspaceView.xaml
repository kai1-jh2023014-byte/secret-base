<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Creative.CreativeWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Creative Workspace — desk for favorite projects/files.
      Not a full Explorer. Move/resize on WidgetFrame.
    -->
    <Border
        x:Name="RootBorder"
        Padding="12,10"
        Background="#CC243447"
        CornerRadius="16"
        BorderThickness="1"
        BorderBrush="#44FFFFFF"
        MinWidth="280"
        MinHeight="360">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="HeaderText"
                Grid.Row="0"
                Text="Creative Workspace"
                FontSize="17"
                FontWeight="SemiBold"
                TextWrapping="WrapWholeWords" />

            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Search projects…"
                    FontSize="12"
                    MinHeight="28"
                    KeyDown="SearchBox_KeyDown"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Search"
                    MinWidth="64"
                    Padding="10,4"
                    Click="SearchButton_Click" />
            </Grid>

            <ScrollViewer
                Grid.Row="2"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentList" Spacing="6" />
            </ScrollViewer>

            <TextBlock
                x:Name="StatusLabel"
                Grid.Row="3"
                FontSize="11"
                Opacity="0.75"
                TextWrapping="WrapWholeWords" />

            <Button
                x:Name="AddButton"
                Grid.Row="4"
                Content="+ Add"
                HorizontalAlignment="Stretch"
                Click="AddButton_Click"
                ToolTipService.ToolTip="Add file or folder (Windows picker)" />
        </Grid>
    </Border>
</UserControl>
