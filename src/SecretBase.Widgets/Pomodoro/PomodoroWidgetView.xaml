<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Pomodoro.PomodoroWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="OuterShell"
        Background="#20151A24"
        CornerRadius="20"
        Padding="2"
        BorderThickness="1"
        BorderBrush="#28FFFFFF">
        <Border
            x:Name="RootBorder"
            Padding="16,14"
            Background="#D9181E28"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#3DFFFFFF"
            MinWidth="160"
            MinHeight="100">
            <Grid>
                <!-- Compact: large remaining + start/pause -->
                <Grid
                    x:Name="CompactPanel"
                    Visibility="Collapsed"
                    RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock
                            x:Name="CompactPhaseText"
                            Text="Ready"
                            FontSize="11"
                            Opacity="0.75"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="CompactExpandButton"
                            Content="[]"
                            MinWidth="28"
                            MinHeight="26"
                            Padding="2"
                            HorizontalAlignment="Right"
                            Click="CompactModeButton_Click"
                            ToolTipService.ToolTip="Expand Pomodoro" />
                    </Grid>
                    <TextBlock
                        x:Name="CompactTimerText"
                        Grid.Row="1"
                        Text="25:00"
                        FontSize="40"
                        FontWeight="Light"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CharacterSpacing="20" />
                    <Button
                        x:Name="CompactPrimaryButton"
                        Grid.Row="2"
                        Content="Start"
                        MinWidth="88"
                        HorizontalAlignment="Center"
                        Click="PrimaryButton_Click" />
                </Grid>

                <!-- Full controls -->
                <Grid x:Name="FullPanel" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="HeaderText"
                                Text="Pomodoro"
                                FontSize="15"
                                FontWeight="SemiBold"
                                CharacterSpacing="40" />
                            <TextBlock
                                x:Name="SubtitleText"
                                Text="Focus / Break / Repeat"
                                FontSize="11"
                                Opacity="0.75" />
                        </StackPanel>
                        <Button
                            x:Name="CompactModeButton"
                            Content="-"
                            MinWidth="32"
                            MinHeight="28"
                            Padding="4,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Click="CompactModeButton_Click"
                            ToolTipService.ToolTip="Compact Pomodoro" />
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                        <TextBlock
                            x:Name="PhaseText"
                            Text="Focus idle"
                            FontSize="13"
                            Opacity="0.85"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="TimerText"
                            Text="25:00"
                            FontSize="48"
                            FontWeight="SemiLight"
                            HorizontalAlignment="Center"
                            CharacterSpacing="20" />
                        <TextBlock
                            x:Name="RoundText"
                            Text="Round 1/4"
                            FontSize="12"
                            Opacity="0.75"
                            HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox
                            x:Name="FocusMinutesBox"
                            Grid.Column="0"
                            Header="Focus (min)"
                            Minimum="1"
                            Maximum="120"
                            Value="25"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="DurationBox_ValueChanged" />
                        <NumberBox
                            x:Name="BreakMinutesBox"
                            Grid.Column="1"
                            Header="Break (min)"
                            Minimum="1"
                            Maximum="60"
                            Value="5"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="DurationBox_ValueChanged" />
                    </Grid>

                    <StackPanel
                        Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                        <Button
                            x:Name="PrimaryButton"
                            Content="Start"
                            MinWidth="88"
                            Click="PrimaryButton_Click" />
                        <Button
                            x:Name="ResetButton"
                            Content="Reset"
                            MinWidth="72"
                            Click="ResetButton_Click" />
                        <Button
                            x:Name="StopButton"
                            Content="Stop"
                            MinWidth="72"
                            Click="StopButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Spacing="4">
                        <CheckBox
                            x:Name="SoundCheckBox"
                            Content="Play sound when a phase ends"
                            IsChecked="True"
                            Checked="SoundCheckBox_Changed"
                            Unchecked="SoundCheckBox_Changed" />
                        <TextBlock
                            x:Name="HintText"
                            FontSize="11"
                            Opacity="0.7"
                            TextWrapping="WrapWholeWords"
                            Text="Custom focus / break - long break after 4 rounds" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
