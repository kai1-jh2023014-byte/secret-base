<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Calendar.CalendarWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Opacity="0">

    <!--
      Calendar — month grid + day agenda + bulk entry.
      Move/resize stay on WidgetFrame DragBar.
    -->
    <Border
        x:Name="OuterShell"
        Background="#20151A24"
        CornerRadius="20"
        Padding="2"
        BorderThickness="1"
        BorderBrush="#28FFFFFF">
        <Border
            x:Name="RootBorder"
            Padding="14,12"
            Background="#66181E28"
            CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#3DFFFFFF">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Reminder toast -->
                <Border
                    x:Name="ReminderBanner"
                    Grid.Row="0"
                    Padding="10,8"
                    CornerRadius="10"
                    Background="#557A9E86"
                    BorderThickness="1"
                    BorderBrush="#66FFFFFF"
                    Visibility="Collapsed"
                    Opacity="0"
                    Margin="0,0,0,2">
                    <TextBlock
                        x:Name="ReminderText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords"
                        Text="Starting now" />
                </Border>

                <!-- Month header -->
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="PrevMonthButton"
                        Grid.Column="0"
                        Content="‹"
                        MinWidth="32"
                        MinHeight="30"
                        Padding="0"
                        Click="PrevMonthButton_Click"
                        ToolTipService.ToolTip="Previous month" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            x:Name="HeaderText"
                            Text="Calendar"
                            FontSize="15"
                            FontWeight="SemiBold"
                            CharacterSpacing="40" />
                        <Border
                            x:Name="HeaderAccent"
                            Width="22"
                            Height="2"
                            HorizontalAlignment="Left"
                            CornerRadius="1"
                            Background="#FF7A9E86"
                            Opacity="0.85" />
                    </StackPanel>
                    <Button
                        x:Name="NextMonthButton"
                        Grid.Column="2"
                        Content="›"
                        MinWidth="32"
                        MinHeight="30"
                        Padding="0"
                        Click="NextMonthButton_Click"
                        ToolTipService.ToolTip="Next month" />
                    <ToggleButton
                        x:Name="NotifyToggle"
                        Grid.Column="3"
                        Content="Notify"
                        MinHeight="30"
                        Padding="10,4"
                        IsChecked="True"
                        Click="NotifyToggle_Click"
                        ToolTipService.ToolTip="Notify when an event starts" />
                </Grid>

                <!-- Weekday labels + month grid -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <Grid x:Name="WeekdayHeader" ColumnSpacing="2" />
                    <Grid x:Name="MonthGrid" ColumnSpacing="2" RowSpacing="2" MinHeight="132" />
                </StackPanel>

                <!-- Selected day agenda -->
                <Grid Grid.Row="3" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock
                            x:Name="SelectedDayLabel"
                            Text="Today"
                            FontSize="12"
                            FontWeight="SemiBold"
                            CharacterSpacing="20"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="TodayJumpButton"
                            Content="Today"
                            HorizontalAlignment="Right"
                            MinHeight="26"
                            Padding="8,2"
                            Click="TodayJumpButton_Click"
                            ToolTipService.ToolTip="Jump to today" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        MinHeight="72">
                        <StackPanel x:Name="AgendaList" Spacing="8" />
                    </ScrollViewer>
                </Grid>

                <TextBlock
                    x:Name="ProviderLabel"
                    Grid.Row="4"
                    FontSize="11"
                    Opacity="0.8"
                    Text="Local"
                    TextWrapping="WrapWholeWords" />

                <TextBlock
                    x:Name="StatusLabel"
                    Grid.Row="5"
                    FontSize="11"
                    Opacity="0.75"
                    TextWrapping="WrapWholeWords"
                    Visibility="Collapsed" />

                <!-- Add mode: single | bulk -->
                <StackPanel Grid.Row="6" Spacing="6" Margin="0,2,0,0">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="SingleModeButton"
                            Grid.Column="0"
                            Content="Add one"
                            HorizontalAlignment="Stretch"
                            MinHeight="28"
                            Click="SingleModeButton_Click"
                            ToolTipService.ToolTip="Add a single timed event" />
                        <Button
                            x:Name="BulkModeButton"
                            Grid.Column="1"
                            Content="Bulk add"
                            HorizontalAlignment="Stretch"
                            MinHeight="28"
                            Click="BulkModeButton_Click"
                            ToolTipService.ToolTip="Paste several events at once" />
                    </Grid>

                    <Grid x:Name="SingleAddPanel" ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="AddTitleBox"
                            Grid.Column="0"
                            PlaceholderText="Event title…"
                            FontSize="12"
                            MinHeight="32"
                            IsReadOnly="False" />
                        <TextBox
                            x:Name="AddTimeBox"
                            Grid.Column="1"
                            PlaceholderText="Start"
                            FontSize="12"
                            MinHeight="32"
                            IsReadOnly="False"
                            ToolTipService.ToolTip="Start HH:mm" />
                        <TextBox
                            x:Name="AddEndTimeBox"
                            Grid.Column="2"
                            PlaceholderText="End"
                            FontSize="12"
                            MinHeight="32"
                            IsReadOnly="False"
                            ToolTipService.ToolTip="End HH:mm" />
                        <Button
                            x:Name="AddEventButton"
                            Grid.Column="3"
                            Content="Add"
                            MinWidth="52"
                            MinHeight="32"
                            Click="AddEventButton_Click"
                            ToolTipService.ToolTip="Add to the selected day (local)" />
                    </Grid>

                    <StackPanel x:Name="BulkAddPanel" Spacing="6" Visibility="Collapsed">
                        <TextBox
                            x:Name="BulkTextBox"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="72"
                            MaxHeight="120"
                            FontSize="12"
                            PlaceholderText="19時勉強&#x0a;20時食事&#x0a;22:00-23:00 英語&#x0a;or 22:00から23:00まで英語"
                            IsReadOnly="False"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="BulkHintLabel"
                                Grid.Column="0"
                                FontSize="11"
                                Opacity="0.7"
                                TextWrapping="WrapWholeWords"
                                Text="One line per event · applies to the selected day" />
                            <Button
                                x:Name="BulkAddButton"
                                Grid.Column="1"
                                Content="Add all"
                                MinWidth="72"
                                MinHeight="30"
                                Click="BulkAddButton_Click"
                                ToolTipService.ToolTip="Parse and add every event to the selected day" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="7" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="RefreshButton"
                        Grid.Column="0"
                        Content="Refresh"
                        HorizontalAlignment="Stretch"
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="Reload calendar" />
                    <Button
                        x:Name="OpenCalendarButton"
                        Grid.Column="1"
                        Content="Open"
                        HorizontalAlignment="Stretch"
                        Click="OpenCalendarButton_Click"
                        ToolTipService.ToolTip="Optional: open calendar in the browser" />
                    <Button
                        x:Name="ConnectButton"
                        Grid.Column="2"
                        Content="Connect"
                        Click="ConnectButton_Click"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Connect Google Calendar (OAuth)" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
