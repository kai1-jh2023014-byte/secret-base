<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.Widgets.Calendar.CalendarWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Today agenda — Think / Manage layer.
      Move/resize stay on WidgetFrame DragBar.
    -->
    <Border
        x:Name="OuterShell"
        Background="#20151A24"
        CornerRadius="20"
        Padding="2"
        BorderThickness="1"
        BorderBrush="#28FFFFFF">
    <Border
        x:Name="RootBorder"
        Padding="14,12"
        Background="#66181E28"
        CornerRadius="18"
        BorderThickness="1"
        BorderBrush="#3DFFFFFF">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock
                    x:Name="HeaderText"
                    Text="Today"
                    FontSize="15"
                    FontWeight="SemiBold"
                    CharacterSpacing="60" />
                <Border
                    x:Name="HeaderAccent"
                    Width="24"
                    Height="2"
                    HorizontalAlignment="Left"
                    CornerRadius="1"
                    Background="#FF7A9E86"
                    Opacity="0.85" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AgendaList" Spacing="10" />
            </ScrollViewer>

            <TextBlock
                x:Name="ProviderLabel"
                Grid.Row="2"
                FontSize="11"
                Opacity="0.8"
                Text="Local"
                TextWrapping="WrapWholeWords" />

            <TextBlock
                x:Name="StatusLabel"
                Grid.Row="3"
                FontSize="11"
                Opacity="0.75"
                TextWrapping="WrapWholeWords"
                Visibility="Collapsed" />

            <Grid Grid.Row="4" ColumnSpacing="6" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="AddTitleBox"
                    Grid.Column="0"
                    PlaceholderText="Add event…"
                    FontSize="12"
                    MinHeight="32"
                    IsReadOnly="False" />
                <TextBox
                    x:Name="AddTimeBox"
                    Grid.Column="1"
                    PlaceholderText="HH:mm"
                    FontSize="12"
                    MinHeight="32"
                    IsReadOnly="False"
                    ToolTipService.ToolTip="Start time — type like 16:00 or use − / +" />
                <Button
                    x:Name="TimeMinusButton"
                    Grid.Column="2"
                    Content="−"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    Click="TimeMinusButton_Click"
                    ToolTipService.ToolTip="15 minutes earlier" />
                <Button
                    x:Name="TimePlusButton"
                    Grid.Column="3"
                    Content="+"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    Click="TimePlusButton_Click"
                    ToolTipService.ToolTip="15 minutes later" />
                <Button
                    x:Name="AddEventButton"
                    Grid.Column="4"
                    Content="Add"
                    MinWidth="56"
                    Click="AddEventButton_Click"
                    ToolTipService.ToolTip="Add a local event in this widget (not Google)" />
            </Grid>

            <Grid Grid.Row="5" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="0"
                    Content="Refresh"
                    HorizontalAlignment="Stretch"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="Reload today's agenda" />
                <Button
                    x:Name="OpenCalendarButton"
                    Grid.Column="1"
                    Content="Open"
                    HorizontalAlignment="Stretch"
                    Click="OpenCalendarButton_Click"
                    ToolTipService.ToolTip="Optional: open calendar in the browser" />
                <Button
                    x:Name="ConnectButton"
                    Grid.Column="2"
                    Content="Connect"
                    Click="ConnectButton_Click"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Connect Google Calendar (OAuth)" />
            </Grid>
        </Grid>
    </Border>
    </Border>
</UserControl>
