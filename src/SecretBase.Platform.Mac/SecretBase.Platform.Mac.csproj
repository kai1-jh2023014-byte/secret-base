<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SecretBase.Platform.Mac</RootNamespace>
    <AssemblyName>SecretBase.Platform.Mac</AssemblyName>
    <Description>macOS adapters for Secret Base. No WinUI, no Dock/Finder replacement.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretBase.Platform.Abstractions\SecretBase.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\SecretBase.Core\SecretBase.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SecretBase.Platform.Mac.Tests" />
  </ItemGroup>

</Project>
