<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SecretBase.App.Mac</RootNamespace>
    <AssemblyName>SecretBase.App.Mac</AssemblyName>
    <ApplicationId>com.secretbase.app</ApplicationId>
    <ApplicationTitle>Secret Base</ApplicationTitle>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretBase.Core\SecretBase.Core.csproj" />
    <ProjectReference Include="..\SecretBase.Infrastructure\SecretBase.Infrastructure.csproj" />
    <ProjectReference Include="..\SecretBase.Platform.Abstractions\SecretBase.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\SecretBase.Platform.Mac\SecretBase.Platform.Mac.csproj" />
  </ItemGroup>
</Project>
