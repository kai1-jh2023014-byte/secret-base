<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SecretBase.App.DesktopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
      Widgets + Blocks desktop layer.
      Debug chrome is Collapsed by default; toggle with Ctrl+Shift+D.
      Safe Exit: Ctrl+Shift+Q. Add Block: Ctrl+Shift+B.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Q"
                Modifiers="Control,Shift"
                Invoked="ExitAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="D"
                Modifiers="Control,Shift"
                Invoked="DebugChromeAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="B"
                Modifiers="Control,Shift"
                Invoked="AddBlockAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Canvas
            x:Name="WidgetCanvas"
            Background="Transparent" />

        <!-- Developer / recovery chrome — hidden in normal overlay UX. -->
        <Border
            x:Name="DebugChrome"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            Padding="10,8"
            CornerRadius="10"
            Background="#99243447">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#FF9AA7B2"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="AddBlockButton"
                    Content="Add Block"
                    Click="AddBlockButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Create a Block (Ctrl+Shift+B)" />
                <Button
                    x:Name="ExitButton"
                    Content="Exit"
                    Click="ExitButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Exit Secret Base (Ctrl+Shift+Q)" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
