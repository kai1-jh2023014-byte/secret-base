<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SecretBase.App.DesktopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- Transparent desktop layer: only widgets + compact chrome should read as UI. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Canvas
            x:Name="WidgetCanvas"
            Background="Transparent" />

        <!-- Compact overlay chrome (not a window title bar). -->
        <Border
            x:Name="OverlayChrome"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            Padding="10,8"
            CornerRadius="10"
            Background="#66243447">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#FF9AA7B2"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="ExitButton"
                    Content="Exit"
                    Click="ExitButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Exit Secret Base and return to the normal Windows desktop" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
