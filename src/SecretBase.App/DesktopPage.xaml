<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SecretBase.App.DesktopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
      Widgets + Blocks desktop layer.
      + Add Widget · Blk · Aa Theme · Grid Arrange (always visible).
      Debug chrome: Ctrl+Shift+D. Safe Exit: Ctrl+Shift+Q.
    -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Q"
                Modifiers="Control,Shift"
                Invoked="ExitAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="D"
                Modifiers="Control,Shift"
                Invoked="DebugChromeAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="B"
                Modifiers="Control,Shift"
                Invoked="AddBlockAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="T"
                Modifiers="Control,Shift"
                Invoked="ThemeAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="W"
                Modifiers="Control,Shift"
                Invoked="AddWebAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="C"
                Modifiers="Control,Shift"
                Invoked="AddCalendarAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="M"
                Modifiers="Control,Shift"
                Invoked="AddMusicAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="E"
                Modifiers="Control,Shift"
                Invoked="AddCreativeAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="A"
                Modifiers="Control,Shift"
                Invoked="AddAiAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="K"
                Modifiers="Control,Shift"
                Invoked="TaskbarAiChatAccelerator_Invoked" />
            <KeyboardAccelerator
                Key="N"
                Modifiers="Control,Shift"
                Invoked="AddWidgetAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Canvas
            x:Name="WidgetCanvas"
            Background="Transparent" />

        <StackPanel
            Orientation="Vertical"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="16,16"
            Spacing="8">
            <TextBlock
                x:Name="HostStatusLabel"
                FontSize="11"
                Opacity="0.9"
                TextWrapping="WrapWholeWords"
                MaxWidth="360"
                Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="AddWidgetFab"
                    Width="48"
                    Height="48"
                    Content="+"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Padding="0"
                    CornerRadius="14"
                    Click="AddWidgetButton_Click"
                    ToolTipService.ToolTip="Add Widget (Ctrl+Shift+N)" />
                <Button
                    x:Name="AddBlockFab"
                    Width="48"
                    Height="48"
                    Content="Blk"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Padding="0"
                    CornerRadius="14"
                    Click="AddBlockButton_Click"
                    ToolTipService.ToolTip="Add Block (Ctrl+Shift+B)" />
                <Button
                    x:Name="ThemeFab"
                    Width="48"
                    Height="48"
                    Content="Aa"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Padding="0"
                    CornerRadius="14"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Theme (Ctrl+Shift+T)" />
                <Button
                    x:Name="ArrangeFab"
                    Width="48"
                    Height="48"
                    Content="Grid"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Padding="0"
                    CornerRadius="14"
                    Click="ArrangeButton_Click"
                    ToolTipService.ToolTip="Arrange widgets &amp; blocks evenly" />
                <Button
                    x:Name="SetupFab"
                    Width="48"
                    Height="48"
                    Content="⚙"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Padding="0"
                    CornerRadius="14"
                    Click="SetupButton_Click"
                    ToolTipService.ToolTip="Setup — Start Menu, Desktop shortcut, Start at login" />
            </StackPanel>
        </StackPanel>

        <!-- Developer / recovery chrome — hidden in normal overlay UX. -->
        <Border
            x:Name="DebugChrome"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,16,16,0"
            Padding="10,8"
            CornerRadius="10"
            Background="#99243447">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#FF9AA7B2"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="ThemeButton"
                    Content="Theme"
                    Click="ThemeButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Edit colors &amp; design" />
                <Button
                    x:Name="ArrangeButton"
                    Content="Arrange"
                    Click="ArrangeButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Arrange widgets &amp; blocks evenly" />
                <Button
                    x:Name="AddWidgetButton"
                    Content="Add Widget"
                    Click="AddWidgetButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Add any widget" />
                <Button
                    x:Name="AddBlockButton"
                    Content="Add Block"
                    Click="AddBlockButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Create a Block" />
                <Button
                    x:Name="ExitButton"
                    Content="Exit"
                    Click="ExitButton_Click"
                    Padding="12,4"
                    ToolTipService.ToolTip="Exit Secret Base (Ctrl+Shift+Q)" />
                <ToggleSwitch
                    x:Name="AutoStartToggle"
                    OffContent="Start at login: Off"
                    OnContent="Start at login: On"
                    Toggled="AutoStartToggle_Toggled"
                    ToolTipService.ToolTip="Register Secret Base in Windows Startup apps (per-user)" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
