<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.App.Desktop.BlockFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    mc:Ignorable="d">

    <!-- Desktop "room": drag / resize chrome + movable item canvas. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="DragBar"
            Grid.Row="0"
            Background="#10FFFFFF"
            CornerRadius="14,14,0,0"
            Opacity="0.28"
            PointerPressed="DragArea_PointerPressed"
            PointerMoved="DragArea_PointerMoved"
            PointerReleased="DragArea_PointerReleased"
            PointerCaptureLost="DragArea_PointerCaptureLost"
            ToolTipService.ToolTip="Drag to move Block">
            <Ellipse
                Width="22"
                Height="3"
                Fill="#55FFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <Border
            x:Name="Surface"
            Grid.Row="1"
            Padding="8,4,8,8"
            CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="HeaderRow"
                    Grid.Row="0"
                    Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="NameText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Opacity="0.9"
                        TextTrimming="CharacterEllipsis"
                        IsHitTestVisible="False" />
                    <Button
                        x:Name="ArrangeButton"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        Padding="0"
                        MinWidth="20"
                        MinHeight="20"
                        Margin="0,0,2,0"
                        Click="ArrangeButton_Click"
                        ToolTipService.ToolTip="Arrange icons evenly">
                        <SymbolIcon
                            Symbol="ViewAll"
                            RenderTransformOrigin="0.5,0.5">
                            <SymbolIcon.RenderTransform>
                                <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
                            </SymbolIcon.RenderTransform>
                        </SymbolIcon>
                    </Button>
                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Padding="0"
                        MinWidth="20"
                        MinHeight="20"
                        Click="DeleteButton_Click"
                        ToolTipService.ToolTip="Delete Block">
                        <SymbolIcon
                            Symbol="Delete"
                            RenderTransformOrigin="0.5,0.5">
                            <SymbolIcon.RenderTransform>
                                <ScaleTransform ScaleX="0.62" ScaleY="0.62" />
                            </SymbolIcon.RenderTransform>
                        </SymbolIcon>
                    </Button>
                </Grid>

                <Canvas
                    x:Name="ItemCanvas"
                    Grid.Row="1"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="Root_DragOver"
                    Drop="Root_Drop" />

                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="1"
                    Text="Drop Desktop shortcuts here (moved in). Use Arrange to tidy icons."
                    FontSize="12"
                    Opacity="0.65"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            x:Name="ResizeHandle"
            Grid.Row="1"
            Width="14"
            Height="14"
            Margin="0,0,3,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#44FFFFFF"
            CornerRadius="3"
            Opacity="0.35"
            PointerPressed="ResizeHandle_PointerPressed"
            PointerMoved="ResizeHandle_PointerMoved"
            PointerReleased="ResizeHandle_PointerReleased"
            PointerCaptureLost="ResizeHandle_PointerCaptureLost"
            ToolTipService.ToolTip="Resize" />
    </Grid>
</UserControl>
