<UserControl
    x:Class="SecretBase.App.Desktop.BlockFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    mc:Ignorable="d">

    <!-- Desktop "room": drag / resize chrome + item grid. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="DragBar"
            Grid.Row="0"
            Background="#18FFFFFF"
            CornerRadius="12,12,0,0"
            Opacity="0.35"
            PointerPressed="DragArea_PointerPressed"
            PointerMoved="DragArea_PointerMoved"
            PointerReleased="DragArea_PointerReleased"
            PointerCaptureLost="DragArea_PointerCaptureLost"
            ToolTipService.ToolTip="Drag to move Block">
            <Ellipse
                Width="28"
                Height="4"
                Fill="#66FFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <Border
            x:Name="Surface"
            Grid.Row="1"
            Padding="12,8,12,12"
            CornerRadius="0,0,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="NameText"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        IsHitTestVisible="False" />
                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="Del"
                        Padding="8,2"
                        MinWidth="32"
                        Click="DeleteButton_Click"
                        ToolTipService.ToolTip="Delete Block" />
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <GridView
                        x:Name="ItemsGrid"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="ItemsGrid_ItemClick"
                        XYFocusKeyboardNavigation="Enabled">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Width="88"
                                    Spacing="4"
                                    Padding="4">
                                    <Border
                                        Width="40"
                                        Height="40"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        Background="#33FFFFFF">
                                        <TextBlock
                                            Text="{Binding Glyph}"
                                            FontSize="18"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontSize="11"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>

                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="1"
                    Text="Drop apps or shortcuts here"
                    FontSize="12"
                    Opacity="0.65"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            x:Name="ResizeHandle"
            Grid.Row="1"
            Width="14"
            Height="14"
            Margin="0,0,3,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#44FFFFFF"
            CornerRadius="3"
            Opacity="0.35"
            PointerPressed="ResizeHandle_PointerPressed"
            PointerMoved="ResizeHandle_PointerMoved"
            PointerReleased="ResizeHandle_PointerReleased"
            PointerCaptureLost="ResizeHandle_PointerCaptureLost"
            ToolTipService.ToolTip="Resize" />
    </Grid>
</UserControl>
