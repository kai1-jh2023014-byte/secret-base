<UserControl
    x:Class="SecretBase.App.Desktop.BlockFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    mc:Ignorable="d">

    <!-- Desktop "room": drag / resize chrome + movable item canvas. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="DragBar"
            Grid.Row="0"
            Background="#18FFFFFF"
            CornerRadius="12,12,0,0"
            Opacity="0.35"
            PointerPressed="DragArea_PointerPressed"
            PointerMoved="DragArea_PointerMoved"
            PointerReleased="DragArea_PointerReleased"
            PointerCaptureLost="DragArea_PointerCaptureLost"
            ToolTipService.ToolTip="Drag to move Block">
            <Ellipse
                Width="28"
                Height="4"
                Fill="#66FFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
        </Border>

        <Border
            x:Name="Surface"
            Grid.Row="1"
            Padding="10,6,10,10"
            CornerRadius="0,0,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="NameText"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        IsHitTestVisible="False" />
                    <Button
                        x:Name="DeleteButton"
                        Grid.Column="1"
                        Content="Del"
                        Padding="8,2"
                        MinWidth="32"
                        Click="DeleteButton_Click"
                        ToolTipService.ToolTip="Delete Block" />
                </Grid>

                <Canvas
                    x:Name="ItemCanvas"
                    Grid.Row="1"
                    Background="Transparent"
                    AllowDrop="True"
                    DragOver="Root_DragOver"
                    Drop="Root_Drop" />

                <TextBlock
                    x:Name="EmptyHint"
                    Grid.Row="1"
                    Text="Drop apps or shortcuts here — then drag to arrange"
                    FontSize="12"
                    Opacity="0.65"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border
            x:Name="ResizeHandle"
            Grid.Row="1"
            Width="14"
            Height="14"
            Margin="0,0,3,3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#44FFFFFF"
            CornerRadius="3"
            Opacity="0.35"
            PointerPressed="ResizeHandle_PointerPressed"
            PointerMoved="ResizeHandle_PointerMoved"
            PointerReleased="ResizeHandle_PointerReleased"
            PointerCaptureLost="ResizeHandle_PointerCaptureLost"
            ToolTipService.ToolTip="Resize" />
    </Grid>
</UserControl>
