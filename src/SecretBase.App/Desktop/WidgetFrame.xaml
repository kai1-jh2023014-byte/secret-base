<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SecretBase.App.Desktop.WidgetFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!-- Floating chrome — quiet until hover; grip + remove + resize. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="4" x:Name="ChromeRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="DragBar"
                Grid.Column="0"
                Background="#14FFFFFF"
                CornerRadius="12,0,0,0"
                Opacity="0.28"
                PointerPressed="DragArea_PointerPressed"
                PointerMoved="DragArea_PointerMoved"
                PointerReleased="DragArea_PointerReleased"
                PointerCaptureLost="DragArea_PointerCaptureLost"
                ToolTipService.ToolTip="Drag to move">
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <Ellipse x:Name="GripDot1" Width="3" Height="3" Fill="#66FFFFFF" />
                    <Ellipse x:Name="GripDot2" Width="3" Height="3" Fill="#66FFFFFF" />
                    <Ellipse x:Name="GripDot3" Width="3" Height="3" Fill="#66FFFFFF" />
                </StackPanel>
            </Border>
            <Button
                x:Name="RemoveButton"
                Grid.Column="1"
                Width="24"
                Height="22"
                Padding="0"
                FontSize="12"
                Content="×"
                Opacity="0.28"
                CornerRadius="0,12,0,0"
                Click="RemoveButton_Click"
                ToolTipService.ToolTip="Remove widget from Secret Base" />
        </Grid>

        <Border
            x:Name="ContentHost"
            Grid.Row="1"
            Background="Transparent" />

        <Border
            x:Name="ResizeHandle"
            Grid.Row="1"
            Width="12"
            Height="12"
            Margin="0,0,4,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#33FFFFFF"
            CornerRadius="3"
            Opacity="0.28"
            PointerPressed="ResizeHandle_PointerPressed"
            PointerMoved="ResizeHandle_PointerMoved"
            PointerReleased="ResizeHandle_PointerReleased"
            PointerCaptureLost="ResizeHandle_PointerCaptureLost"
            ToolTipService.ToolTip="Resize" />
    </Grid>
</UserControl>
